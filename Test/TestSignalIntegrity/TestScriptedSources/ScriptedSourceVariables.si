<Project>
	<CalculationProperties>
		<EndFrequency>20000000000.0</EndFrequency>
		<FrequencyPoints>2000</FrequencyPoints>
		<UserSampleRate>40000000000.0</UserSampleRate>
	</CalculationProperties>
	<Drawing>
		<DrawingProperties>
			<Geometry>711x363+208+208</Geometry>
			<Grid>14.0</Grid>
			<Originx>1</Originx>
			<Originy>4</Originy>
		</DrawingProperties>
		<Schematic>
			<Devices>
				<Device>
					<ClassName>DeviceVoltageScriptedSource</ClassName>
					<PartPicture>
						<Index>0</Index>
						<MirroredHorizontally>False</MirroredHorizontally>
						<MirroredVertically>False</MirroredVertically>
						<Orientation>0</Orientation>
						<Origin>(5, 5)</Origin>
					</PartPicture>
					<PartProperties>
						<PartProperty>
							<Keyword>show</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>true</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>ho</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>-1.0000000000000001e-07</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>dur</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>2.0000000000000002e-07</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>t0</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>1e-08</Value>
							<Visible>True</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>fs</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>40000000000.0</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>wftype</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>scripted</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>script</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value># Voltage Scripted Source exercising device variables of each type&#10;#   amplitude - float, references the system variable amplitude&#10;#   freq      - float, burst frequency (Hz)&#10;#   cycles    - int, number of cycles in the burst&#10;#   shape     - string, 'sine' or 'triangle'&#10;# The burst starts at t0 and is zero at both ends, so no sample sits on a discontinuity.&#10;def triangle(phase):&#10;    if phase &lt; 0.25: return 4.*phase&#10;    if phase &lt; 0.75: return 2.-4.*phase&#10;    return 4.*phase-4.&#10;K = int(math.ceil(fs*dur))&#10;output_waveform = []&#10;for k in range(K):&#10;    t = ho+k/fs-t0&#10;    if t &lt; 0. or t*freq &gt;= cycles:&#10;        output_waveform.append(0.)&#10;    elif shape == 'sine':&#10;        output_waveform.append(amplitude*math.sin(2.*math.pi*freq*t))&#10;    else:&#10;        output_waveform.append(amplitude*triangle((t*freq)%1.))&#10;</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>ports</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>1</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>ref</Keyword>
							<KeywordVisible>False</KeywordVisible>
							<Value>VS1</Value>
							<Visible>False</Visible>
						</PartProperty>
					</PartProperties>
					<Variables>
						<Items>
							<Variable>
								<Description>burst amplitude</Description>
								<Name>amplitude</Name>
								<ReadOnly>False</ReadOnly>
								<Type>float</Type>
								<Units>V</Units>
								<Value>=amplitude</Value>
								<Visible>True</Visible>
							</Variable>
							<Variable>
								<Description>burst frequency</Description>
								<Name>freq</Name>
								<ReadOnly>False</ReadOnly>
								<Type>float</Type>
								<Units>Hz</Units>
								<Value>500000000.0</Value>
								<Visible>True</Visible>
							</Variable>
							<Variable>
								<Description>number of cycles in the burst</Description>
								<Name>cycles</Name>
								<ReadOnly>False</ReadOnly>
								<Type>int</Type>
								<Units></Units>
								<Value>3</Value>
								<Visible>True</Visible>
							</Variable>
							<Variable>
								<Description>sine or triangle</Description>
								<Name>shape</Name>
								<ReadOnly>False</ReadOnly>
								<Type>string</Type>
								<Units></Units>
								<Value>triangle</Value>
								<Visible>True</Visible>
							</Variable>
						</Items>
					</Variables>
				</Device>
