				<Device>
					<ClassName>DeviceWaveformProcessorVariable</ClassName>
					<PartPicture>
						<Index>0</Index>
						<MirroredHorizontally>False</MirroredHorizontally>
						<MirroredVertically>False</MirroredVertically>
						<Orientation>0</Orientation>
						<Origin>(68, 13)</Origin>
					</PartPicture>
					<PartProperties>
						<PartProperty>
							<Keyword>calcprop</Keyword>
							<KeywordVisible>False</KeywordVisible>
							<Value>false</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>script</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value># Apply saved DFE settings after the schematic CTLE and FFE, with optional timing training.&#10;# &lt;waveform-processor-interface&gt;&#10;# {&#10;#   &quot;version&quot;: 1,&#10;#   &quot;ports&quot;: {&quot;inputs&quot;: 1, &quot;outputs&quot;: 1},&#10;#   &quot;variables&quot;: [&#10;#     {&quot;name&quot;: &quot;baud_rate&quot;, &quot;description&quot;: &quot;Symbol rate&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 106.25e9, &quot;units&quot;: &quot;Baud&quot;},&#10;#     {&quot;name&quot;: &quot;levels&quot;, &quot;description&quot;: &quot;Number of equally spaced PAM levels&quot;, &quot;type&quot;: &quot;int&quot;, &quot;default&quot;: 4},&#10;#     {&quot;name&quot;: &quot;amplitude&quot;, &quot;description&quot;: &quot;Output outer-level peak-to-peak amplitude&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 0.4, &quot;units&quot;: &quot;V&quot;},&#10;#     {&quot;name&quot;: &quot;dfe_taps_input&quot;, &quot;description&quot;: &quot;Saved normalized DFE coefficients (list or scalar)&quot;, &quot;type&quot;: &quot;string&quot;, &quot;default&quot;: &quot;[0]&quot;},&#10;#     {&quot;name&quot;: &quot;ffe_taps_input&quot;, &quot;description&quot;: &quot;Upstream FFE coefficients for offset normalization only&quot;, &quot;type&quot;: &quot;string&quot;, &quot;default&quot;: &quot;[1]&quot;, &quot;visible&quot;: false},&#10;#     {&quot;name&quot;: &quot;normalization_offset_input&quot;, &quot;description&quot;: &quot;Saved offset before the FFE&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 0, &quot;units&quot;: &quot;V&quot;, &quot;visible&quot;: false},&#10;#     {&quot;name&quot;: &quot;normalization_scale_input&quot;, &quot;description&quot;: &quot;Saved scale before the FFE&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 1, &quot;units&quot;: &quot;V&quot;, &quot;visible&quot;: false},&#10;#     {&quot;name&quot;: &quot;bias_input&quot;, &quot;description&quot;: &quot;Saved normalized equalizer bias&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 0, &quot;visible&quot;: false},&#10;#     {&quot;name&quot;: &quot;sample_time_input&quot;, &quot;description&quot;: &quot;Waveform delay for centered decisions (normalized to one UI)&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 0, &quot;units&quot;: &quot;s&quot;},&#10;#     {&quot;name&quot;: &quot;train_sample_time&quot;, &quot;description&quot;: &quot;Optimize the sampling delay using the saved DFE taps (True/False)&quot;, &quot;type&quot;: &quot;string&quot;, &quot;default&quot;: &quot;False&quot;},&#10;#     {&quot;name&quot;: &quot;sample_time_output&quot;, &quot;description&quot;: &quot;Applied waveform delay for centered decisions (normalized to one UI)&quot;, &quot;type&quot;: &quot;float&quot;, &quot;default&quot;: 0, &quot;units&quot;: &quot;s&quot;, &quot;read_only&quot;: true}&#10;#   ]&#10;# }&#10;# &lt;/waveform-processor-interface&gt;&#10;# Input is the voltage AFTER FFE, with no additional voltage amplifier.&#10;# FFE((CTLE - offset) / scale) = (FFE(CTLE) - offset * sum(FFE taps)) / scale.&#10;# This applies WFP1's saved normalization/bias, then its normalized PAM decisions.&#10;# Copy levels and amplitude from WFP1 if those are changed.&#10;# Link sample_time_input to the system variable written by WFP1's sample_time_output.&#10;# sample_time_input is a waveform DELAY in seconds, normalized to one UI.&#10;# Input decisions occur at n/baud_rate - delay, independent of waveform start.&#10;# The output is delayed by this amount, placing decisions at n/baud_rate and&#10;# centering the eye with auto alignment and clock recovery both disabled.&#10;# Delays separated by an integer number of UI are equivalent.&#10;# With train_sample_time=True, search one UI for minimum decision-directed PAM&#10;# error after feedback. Only timing is trained; saved taps/normalization stay fixed.&#10;# Score up to 4096 symbols after startup, requiring at least 64 usable symbols.&#10;# sample_time_output reports the delay actually applied, also in fixed mode.&#10;# Feedback history starts at zero at the first available decision in the input.&#10;# Training excludes the DFE's own history warmup, without assuming an FFE layout.&#10;# Output discards the startup prefix until the feedback uses only observed decisions.&#10;# Hold the feedback correction per UI; do not replace samples by decisions.&#10;# Empty or all-zero DFE taps disable feedback, but normalization/bias still apply.&#10;# Before DFE, sinc-resample the analog FFE output onto a common clock-referenced&#10;# sample grid. Regridding after feedback would smear its edges differently.&#10;# Output retains the sample rate and end time; its start advances past warmup.&#10;# Its sample grid is referenced to zero after the delay. Rephasing moves that&#10;# grid by at most half a sample; trimming never resets the waveform's time origin.&#10;&#10;import ast&#10;import numpy as np&#10;from SignalIntegrity.Lib.TimeDomain.Waveform.Waveform import Waveform&#10;from SignalIntegrity.Lib.TimeDomain.Waveform.TimeDescriptor import TimeDescriptor&#10;from SignalIntegrity.Lib.TimeDomain.Filters.InterpolatorSinX import FractionalDelayFilterSinX&#10;&#10;def coefficients(value, name, allow_empty=False):&#10;    if isinstance(value, str):&#10;        value = ast.literal_eval(value)&#10;    if isinstance(value, (int, float, np.integer, np.floating)) and not isinstance(value, bool):&#10;        value = [value]&#10;    if not isinstance(value, (list, tuple, np.ndarray)):&#10;        raise ValueError(name + ' must be a real scalar or coefficient list')&#10;    if any(isinstance(item, bool) or not isinstance(item, (int, float, np.integer, np.floating))&#10;           for item in value):&#10;        raise ValueError(name + ' must contain only real coefficients')&#10;    result = np.asarray(value, dtype=float)&#10;    if result.ndim != 1 or (not allow_empty and result.size == 0) or not np.all(np.isfinite(result)):&#10;        raise ValueError(name + ' must contain finite real coefficients')&#10;    return result&#10;&#10;feedback = coefficients(dfe_taps_input, 'dfe_taps_input', allow_empty=True)&#10;ffe = coefficients(ffe_taps_input, 'ffe_taps_input')&#10;if isinstance(train_sample_time, str):&#10;    if train_sample_time.strip().lower() not in ('true', 'false'):&#10;        raise ValueError('train_sample_time must be True or False')&#10;    train_sample_time = train_sample_time.strip().lower() == 'true'&#10;elif not isinstance(train_sample_time, (bool, np.bool_)):&#10;    raise ValueError('train_sample_time must be True or False')&#10;if not np.isfinite(baud_rate) or baud_rate &lt;= 0:&#10;    raise ValueError('baud_rate must be finite and positive')&#10;if not np.isfinite(levels) or levels != int(levels) or levels &lt; 2:&#10;    raise ValueError('levels must be an integer &gt;= 2')&#10;if not np.isfinite(amplitude) or amplitude &lt;= 0:&#10;    raise ValueError('amplitude must be finite and positive')&#10;for name, value in [('normalization_offset_input', normalization_offset_input),&#10;                    ('normalization_scale_input', normalization_scale_input),&#10;                    ('bias_input', bias_input), ('sample_time_input', sample_time_input)]:&#10;    if not np.isfinite(value):&#10;        raise ValueError(name + ' must be finite')&#10;if normalization_scale_input &lt;= 0:&#10;    raise ValueError('require normalization_scale_input &gt; 0')&#10;&#10;td = input_waveform_1.td&#10;samples = np.asarray(input_waveform_1.Values(), dtype=float)&#10;if td is None or not np.isfinite(td.H) or not np.isfinite(td.Fs) or td.Fs &lt; 2 * baud_rate:&#10;    raise ValueError('input must have a finite start time and sample rate at least twice baud_rate')&#10;if len(samples) != td.K or len(samples) == 0 or not np.all(np.isfinite(samples)):&#10;    raise ValueError('input must contain finite samples matching its time descriptor')&#10;normalized = (samples - normalization_offset_input * np.sum(ffe)) / normalization_scale_input + bias_input&#10;cycles = sample_time_input * baud_rate&#10;fraction = cycles % 1&#10;tolerance = 8 * np.finfo(float).eps * max(1., abs(cycles))&#10;if min(fraction, 1 - fraction) &lt;= tolerance:&#10;    sample_time = 0.&#10;else:&#10;    sample_time = float(sample_time_input) if 0 &lt;= sample_time_input &lt; 1 / baud_rate else float(fraction / baud_rate)&#10;alphabet = np.linspace(-1., 1., int(levels))&#10;alphabet /= np.sqrt(np.mean(alphabet ** 2))&#10;spacing = alphabet[1] - alphabet[0]&#10;sps = td.Fs / baud_rate&#10;&#10;def apply_feedback(delay, training=False):&#10;    output_start = round((td.H + delay) * td.Fs) / td.Fs&#10;    dfe_td = TimeDescriptor(output_start - delay, td.K, td.Fs)&#10;    values = normalized&#10;    if abs((dfe_td.H - td.H) * td.Fs) &gt; Waveform.epsilon:&#10;        padding = FractionalDelayFilterSinX.S + 1&#10;        padded = Waveform(&#10;            TimeDescriptor(td.H - padding / td.Fs, td.K + 2 * padding, td.Fs),&#10;            np.pad(normalized, padding, mode='edge').tolist())&#10;        padded.adaptionStrategy = 'SinX'&#10;        rephased = padded.Adapt(dfe_td)&#10;        if len(rephased) != td.K:&#10;            raise ValueError('DFE sample-grid alignment changed the sample count')&#10;        values = np.asarray(rephased.Values(), dtype=float)&#10;    if not training and not np.any(feedback):&#10;        return dfe_td, values&#10;    start_ui = (dfe_td.H + delay) * baud_rate&#10;    # Absolute times can lose a few ulps when converted to symbol coordinates.&#10;    clock_tolerance = 8 * np.finfo(float).eps * max(&#10;        1., abs(dfe_td.H * baud_rate), abs(delay * baud_rate), len(samples) / sps)&#10;&#10;    def clock_coordinate(value):&#10;        nearest = np.rint(value)&#10;        return np.where(np.abs(value - nearest) &lt;= clock_tolerance, nearest, value)&#10;&#10;    first_symbol = int(np.ceil(clock_coordinate(start_ui)))&#10;    last_symbol = int(np.floor(clock_coordinate(start_ui + (len(samples) - 1) / sps)))&#10;    symbols = np.arange(first_symbol, last_symbol + 1)&#10;    if len(symbols) == 0:&#10;        raise ValueError('input contains no decision at the supplied sample time')&#10;    if training:&#10;        symbols = symbols[:4096]&#10;        if len(symbols) &lt; max(64, 2 * len(feedback) + 16):&#10;            raise ValueError('input too short to train sample time; require at least 64 usable symbols')&#10;    positions = (symbols - start_ui) * sps&#10;    decision_input = np.interp(positions, np.arange(len(samples)), values)&#10;    corrections = np.empty(len(symbols))&#10;    decisions = np.zeros(len(symbols) + len(feedback))&#10;    for n, value in enumerate(decision_input):&#10;        corrections[n] = np.dot(feedback, decisions[n:n + len(feedback)][::-1])&#10;        sliced = value - corrections[n]&#10;        index = min(int(levels) - 1, max(0, round((sliced - alphabet[0]) / spacing)))&#10;        decisions[n + len(feedback)] = alphabet[index]&#10;    if training:&#10;        skip = max(16, len(feedback))&#10;        errors = decision_input - corrections - decisions[len(feedback):]&#10;        return float(np.mean(errors[skip:] ** 2) / spacing ** 2)&#10;    # A trailing partial UI needs feedback from the last available decisions,&#10;    # even when its own decision time lies beyond the input waveform.&#10;    corrections = np.append(corrections, np.dot(feedback, decisions[len(symbols):][::-1]))&#10;    symbol_for_sample = np.floor(clock_coordinate(start_ui + np.arange(len(samples)) / sps + .5)).astype(int)&#10;    correction_indices = np.clip(symbol_for_sample - first_symbol, 0, len(corrections) - 1)&#10;    corrected = values - corrections[correction_indices]&#10;    first_valid = int(np.searchsorted(symbol_for_sample, first_symbol + len(feedback)))&#10;    if first_valid &gt;= len(values):&#10;        raise ValueError('input too short to produce output after DFE feedback warmup')&#10;    return (TimeDescriptor(dfe_td.H + first_valid / dfe_td.Fs,&#10;                           len(values) - first_valid, dfe_td.Fs),&#10;            corrected[first_valid:])&#10;&#10;if train_sample_time:&#10;    scores = {}&#10;&#10;    def timing_score(phase):&#10;        phase = round(float(phase % 1.), 12) % 1.&#10;        if phase not in scores:&#10;            scores[phase] = apply_feedback(phase / baud_rate, training=True)&#10;        return scores[phase], phase&#10;&#10;    best = min(timing_score(phase) for phase in np.arange(32) / 32.)&#10;    best = min(best, timing_score(sample_time * baud_rate))&#10;    step = 1. / 32.&#10;    for _ in range(3):&#10;        center = best[1]&#10;        best = min(best, *(timing_score(center + offset * step)&#10;                           for offset in np.arange(-4, 5) / 4.))&#10;        step /= 4.&#10;    sample_time = best[1] / baud_rate&#10;&#10;sample_time_output = sample_time&#10;td, corrected = apply_feedback(sample_time)&#10;output = corrected * amplitude / (2 * alphabet[-1])&#10;if not np.all(np.isfinite(output)):&#10;    raise ValueError('DFE output contains nonfinite samples')&#10;output_waveform_1 = Waveform(td, output.tolist()).DelayBy(sample_time)&#10;</Value>
