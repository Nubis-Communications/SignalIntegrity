	<Equations>
		<AutoDebug>True</AutoDebug>
		<Lines>
			<EquationLine>
				<Line>if ic_type.lower() == 'tia':</Line>
			</EquationLine>
			<EquationLine>
				<Line>&#09;path_to_meas = './tia structures/'</Line>
			</EquationLine>
			<EquationLine>
				<Line>elif ic_type.lower() == 'dvr':</Line>
			</EquationLine>
			<EquationLine>
				<Line>&#09;path_to_meas = './driver structures/'</Line>
			</EquationLine>
			<EquationLine>
				<Line>else:</Line>
			</EquationLine>
			<EquationLine>
				<Line>&#09;raise ValueError('ic_type must be either tia or dvr')</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>import os</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>if lane_number &lt; 4:</Line>
			</EquationLine>
			<EquationLine>
				<Line>    lane_number = 7 - lane_number</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>short_meas_file_name = os.path.join(path_to_meas,f'Short_lane_{lane_number}.s4p')</Line>
			</EquationLine>
			<EquationLine>
				<Line>open_meas_file_name = os.path.join(path_to_meas,f'Open_lane_{lane_number}.s4p')</Line>
			</EquationLine>
			<EquationLine>
				<Line>load_meas_file_name = os.path.join(path_to_meas,f'Load_lane_{lane_number}.s4p')</Line>
			</EquationLine>
			<EquationLine>
				<Line>thru_meas_file_name = os.path.join(path_to_meas,f'Thru_lane_{lane_number}.s4p')</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
		</Lines>
	</Equations>
