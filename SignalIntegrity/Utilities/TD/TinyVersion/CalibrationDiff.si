	<Equations>
		<AutoDebug>True</AutoDebug>
		<Lines>
			<EquationLine>
				<Line>path_to_meas = './Deemb structures/'</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>import os</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>if lane_number &lt; 4:</Line>
			</EquationLine>
			<EquationLine>
				<Line>    lane_number = 7 - lane_number</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>short_1_meas_file_name = os.path.join(path_to_meas,f'Short1_lane_{lane_number}.s1p')</Line>
			</EquationLine>
			<EquationLine>
				<Line>open_1_meas_file_name = os.path.join(path_to_meas,f'Open1_lane_{lane_number}.s1p')</Line>
			</EquationLine>
			<EquationLine>
				<Line>load_1_meas_file_name = os.path.join(path_to_meas,f'Load1_lane_{lane_number}.s1p')</Line>
			</EquationLine>
			<EquationLine>
				<Line>short_2_meas_file_name = os.path.join(path_to_meas,f'Short2_lane_{lane_number}.s1p')</Line>
