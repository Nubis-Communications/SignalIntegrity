				<Name>ImpulseResponseLength</Name>
				<ReadOnly>True</ReadOnly>
				<Type>float</Type>
				<Units>s</Units>
				<Value>1e-07</Value>
				<Visible>False</Visible>
			</Variable>
			<Variable>
