				<Name>Fs</Name>
				<ReadOnly>True</ReadOnly>
				<Type>float</Type>
				<Units>S/s</Units>
				<Value>160000000000.0</Value>
				<Visible>False</Visible>
			</Variable>
			<Variable>
				<Description>pulse width (s)</Description>
				<Name>T_b</Name>
				<ReadOnly>True</ReadOnly>
				<Type>float</Type>
				<Units>s</Units>
				<Value>9.411764705882353e-12</Value>
