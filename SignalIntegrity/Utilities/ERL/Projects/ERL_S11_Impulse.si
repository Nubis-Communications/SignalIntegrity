	<Equations>
		<AutoDebug>True</AutoDebug>
		<Lines>
			<EquationLine>
				<Line>T_b=1/f_b</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>if tukey_window == 'True':</Line>
			</EquationLine>
			<EquationLine>
				<Line>    #sinc_element_state='thru_wires'</Line>
			</EquationLine>
			<EquationLine>
				<Line>    tukey_element_state='None'</Line>
			</EquationLine>
			<EquationLine>
				<Line>elif tukey_window == 'False':</Line>
			</EquationLine>
			<EquationLine>
				<Line>    #sinc_element_state='None'</Line>
			</EquationLine>
			<EquationLine>
				<Line>    tukey_element_state='thru_wires'</Line>
			</EquationLine>
			<EquationLine>
				<Line>else:</Line>
			</EquationLine>
			<EquationLine>
				<Line>    raise ValueError(&quot;tukey_window must be 'True' or 'False'&quot;)</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>if butterworth == 'True':</Line>
			</EquationLine>
			<EquationLine>
				<Line>    bwf_element_state='None'</Line>
			</EquationLine>
			<EquationLine>
				<Line>elif butterworth == 'False':</Line>
			</EquationLine>
			<EquationLine>
				<Line>    bwf_element_state='thru_wires'</Line>
			</EquationLine>
			<EquationLine>
				<Line>else:</Line>
			</EquationLine>
			<EquationLine>
				<Line>    raise ValueError(&quot;butterworth must be 'True' or 'False'&quot;)</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>import SignalIntegrity.Lib as si</Line>
			</EquationLine>
			<EquationLine>
				<Line>sp=si.sp.SParameterFile(file_name)</Line>
			</EquationLine>
			<EquationLine>
				<Line>Fe=sp.m_f[-1]</Line>
			</EquationLine>
			<EquationLine>
				<Line>User_Fs=f_b*phi</Line>
			</EquationLine>
			<EquationLine>
				<Line>Fs=min(Fe*2,User_Fs)</Line>
			</EquationLine>
			<EquationLine>
				<Line>ImpulseResponseLength=1./(Fe/(len(sp.m_f)-1))</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line>import SignalIntegrity.App.Project</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp=SignalIntegrity.App.Project['CalculationProperties']</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp['EndFrequency']=Fs/2</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp['ImpulseResponseLength']=ImpulseResponseLength</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp['TimePoints']=int(cp['ImpulseResponseLength']*cp['BaseSampleRate']+0.5)</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp['FrequencyPoints']=int((cp['TimePoints']/2))</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp['FrequencyPoints']=max(1,cp['FrequencyPoints'])</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp.CalculateOthersFromBaseInformation()</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp['UserSampleRate']=User_Fs</Line>
			</EquationLine>
			<EquationLine>
				<Line>cp.CalculateOthersFromBaseInformation()</Line>
			</EquationLine>
			<EquationLine>
				<Line>ImpulseResponseLength=cp['ImpulseResponseLength']</Line>
			</EquationLine>
			<EquationLine>
				<Line>dur_desired=2*N*T_b</Line>
			</EquationLine>
			<EquationLine>
				<Line>ho_desired=-dur_desired/2.</Line>
			</EquationLine>
			<EquationLine>
				<Line>ho=(round((ho_desired-ImpulseResponseLength/2.)/cp['BaseSamplePeriod']))*cp['BaseSamplePeriod']</Line>
			</EquationLine>
			<EquationLine>
				<Line># make sure impulse occurs exactly at time 0</Line>
			</EquationLine>
			<EquationLine>
				<Line>ho=0-int((0-ho)/cp['BaseSamplePeriod']-0.5)*cp['BaseSamplePeriod']</Line>
			</EquationLine>
			<EquationLine>
				<Line>dur=(round((dur_desired+ImpulseResponseLength)/cp['BaseSamplePeriod']))*cp['BaseSamplePeriod']</Line>
			</EquationLine>
			<EquationLine>
				<Line>start=-T_b/2.</Line>
			</EquationLine>
		</Lines>
	</Equations>
